#
# idna, IDNA2008 and UTS 46 for C++20. A program uses it through
# /webcpp/idna//idna, which adds its headers, Boost's and webcpp's
# configuration.

project /webcpp/idna ;

alias idna : : : : <include>include <library>/boost//headers <library>/webcpp/config//config ;
